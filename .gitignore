# scraper state: browser profile, cookie lists, outputs
.indeed-state/
# persistent data workspace: session cookies and the browser profile are
# secrets and must never be published; the scrape history and the organized
# master list are versioned so the mirror keeps a second copy.
data/*
!data/runs/
!data/master/
# tool artifacts
.graphflow/
graphflow-out/
.ruff_cache/
.pytest_cache/
.file_contents_output/
.repo_summary/
.venv/
__pycache__/
*.pyc
log_*.txt
log_*.json
job_data_extended.csv
pytestdebug.log

# personal documents: the operator's resume in every format, and the copies
# the resume tests use. These carry a real name, phone number and employment
# history, and this repository is mirrored to a public host - they must never
# be committed. The converter itself (indeed_scraper/resume/) is committed;
# only the documents are not.
resume/
tests/fixtures/*.docx
# The resume round-trip test asserts the contact details of those personal
# documents, so it names a real phone number and cannot be published either.
# It stays in the working tree and runs locally, where the documents are.
tests/test_resume_convert.py

# api backend
api/.venv/
api/.pytest_cache/
api/**/__pycache__/
api/*.egg-info/
api/dist/
api/.ruff_cache/

# frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.vue-tsc/
frontend/coverage/
